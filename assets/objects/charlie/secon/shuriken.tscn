[sub_resource type="GDScript" id="GDScript_u12sj"]
script/source = "extends Area2D

@onready var parent := get_parent()

func _on_area_entered(area: Area2D) -> void:
	if area is EnemyHurtboxComponent:
		parent.target_direction = parent.global_position - area.global_position
		
		parent.velocity = Vector2.ZERO
		parent.velocity = parent.target_direction.normalized() * (parent.speed * -1)
"

