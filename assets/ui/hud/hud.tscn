[sub_resource type="GDScript" id="GDScript_1llwp"]
script/source = "extends RichTextLabel

func _ready() -> void:
	SignalBus.connect(\"show_fps\", show_fps)
	show_fps(PlayerVar.show_fps)

func show_fps(yes: bool) -> void:
	if yes:
		show()
	else:
		hide()

func _process(_delta: float) -> void:
	if visible:
		text = \"[center][b]FPS:[/b] %s[/center]\" % Engine.get_frames_per_second()
"

